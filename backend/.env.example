# Set these in your terminal or hosting provider. No real secrets in Git.
STUDYPILOT_DB=backend/data/studypilot.db
ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
ALLOW_REGISTRATION=true
REQUIRE_AI=true
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
AI_USER_DAILY_LIMIT=10
AI_GLOBAL_DAILY_LIMIT=100
# HTTPS deployment: COOKIE_SECURE=true
# Render's RENDER_EXTERNAL_URL is automatically accepted as an origin.
